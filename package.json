{
  "name": "aes67-stream-monitor",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "AOIP STREAM MONITOR",
  "author": "Kidney",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "dev:electron": "electron .",
    "dev:app": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && npm run dev:electron\"",
    "test": "node --test \"utils/*.test.ts\"",
    "build": "vite build",
    "package": "npm run build && electron-builder"
  },
  "build": {
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "utils/sdp.js",
      "package.json"
    ],
    "icon": "dist/icon.ico",
    "win": {
      "icon": "dist/icon.ico"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^7.2.0"
  }
}
